# ============================================================
# solosatset - Environment Variables EXAMPLE
# Copy file ini menjadi .env dan isi dengan nilai asli Anda.
# JANGAN commit nilai rahasia ke GitHub.
# ============================================================

SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-side SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=solosatset.soloraya@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_NAME="Pusat Jual Beli Solo Raya"
SMTP_FROM=solosatset.soloraya@gmail.com
EMAIL_API_TOKEN=generate_a_long_random_server_token

# Web Push
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:solosatset.soloraya@gmail.com
PUSH_API_TOKEN=generate_a_long_random_push_server_token
