{
  "name": "solosatset",
  "version": "2.2.0",
  "description": "solosatset - Platform Jual Beli Barang Se-Solo Raya",
  "type": "module",
  "scripts": {
    "build": "npm run test:syntax && npm run audit:security:strict && npm run audit:assets",
    "test": "node scripts/test-formatting.js && node scripts/test-syntax.js",
    "test:syntax": "node scripts/test-syntax.js",
    "audit:duplication": "node scripts/duplicate-audit.js",
    "audit:assets": "node scripts/test-asset-integrity.js",
    "audit:security": "node scripts/security-pattern-audit.js",
    "audit:security:strict": "node scripts/security-pattern-audit.js --strict",
    "audit:all": "npm run audit:duplication && npm run audit:assets && npm run audit:security",
    "sync:reviews": "node scripts/sync-app-reviews.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.4.2",
    "nodemailer": "^6.9.14",
    "web-push": "^3.6.7"
  }
}
